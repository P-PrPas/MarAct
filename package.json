{
  "name": "maract",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'npm run dev:api' 'npm run dev:web'",
    "dev:api": "node --env-file-if-exists=.env --watch --import tsx backend/src/app/server.ts",
    "dev:web": "vite frontend --strictPort",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p backend/tsconfig.json",
    "build:web": "vite build frontend",
    "start": "node --env-file-if-exists=.env backend/dist/app/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/db.mjs migrate",
    "seed": "node --env-file-if-exists=.env scripts/db.mjs seed",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p backend/tsconfig.check.json",
    "test:api": "node --env-file-if-exists=.env --import tsx --test 'backend/src/modules/**/*.test.ts'",
    "test:web": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test:api && npm run test:web"
  },
  "dependencies": {
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^9.2.5",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
